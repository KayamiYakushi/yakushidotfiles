{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "reload_style_on_change": true,
    "spacing": 0,
    "modules-left": [
        "memory",
        "cpu",
        "custom/cpu_temp",
        "custom/gpu_temp"
    ],
    "modules-center": [
        "custom/mpris-marquee"
    ],
    "modules-right": [
        "pulseaudio",
        "clock",
        "custom/power"
    ],
    "cpu": {
        "interval": 1,
        "format": "CPU {usage}%"
    },
    "memory": {
        "interval": 5,
        "format": "RAM {used:0.2f} GB",
        "tooltip-format": "{used:0.2f} GB / {total:0.2f} GB"
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu_usage.sh",
        "format": "GPU {}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Skylake-H GT2: {}%"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },
    "custom/mpris-marquee": {
        "exec": "~/.config/waybar/scripts/mpris-marquee.sh",
        "return-type": "json",
        "format": "{}",
        "on-click": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" play-pause",
        "on-click-right": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" next",
        "on-click-middle": "playerctl --player=\"$(~/.config/waybar/scripts/playerctl-active.sh)\" previous"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "pgrep -x wlogout >/dev/null || wlogout -b 1 -c 20 -r 20 -L 1700 -R 1700 -T 325 -B 325"
    },
    "custom/cpu_temp": {
        "exec": "~/.config/waybar/scripts/yakushi_cpu_temp.sh",
        "interval": 2,
        "format": "{}",
        "tooltip": false
    },
    "custom/gpu_temp": {
        "exec": "~/.config/waybar/scripts/yakushi_gpu_temp.sh",
        "interval": 2,
        "format": "{}",
        "tooltip": false
    }
}
