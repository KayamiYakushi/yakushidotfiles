{
    "include": ["~/.config/waybar/hardware.local.jsonc"],
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "reload_style_on_change": true,
    "spacing": 0,
    "modules-left": [
        "memory",
        "cpu",
        "temperature#cpu",
        "temperature#gpu"
    ],
    "modules-center": [
        "mpris"
    ],
    "modules-right": [
        "pulseaudio",
        "clock#date",
        "clock",
        "custom/power"
    ],
    "cpu": {
        "interval": 2,
        "format": "CPU {usage}%"
    },
    "memory": {
        "interval": 10,
        "format": "RAM {used:0.2f} GB",
        "tooltip-format": "{used:0.2f} GB / {total:0.2f} GB"
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu_usage.sh",
        "format": "GPU {}%",
        "interval": 1,
        "tooltip": true,
        "tooltip-format": "Skylake-H GT2: {}%"
    },
    "clock#date": {
        "interval": 60,
        "format": "{:%a %d %b}",
        "locale": "C",
        "tooltip": false
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<b><u>{}</u></b>"
            }
        }
    },
    "mpris": {
        "player": "playerctld",
        "format": "♪  {dynamic}",
        "format-paused": "♪  {dynamic}",
        "format-stopped": "♪  {dynamic}",
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-importance-order": [
            "title",
            "artist"
        ],
        "dynamic-separator": " - ",
        "dynamic-len": 30,
        "title-len": 30,
        "artist-len": 30,
        "tooltip-format": "{title} - {artist}"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": [
                "",
                "",
                ""
            ]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
        "on-click-right": "~/.config/quickshell/scripts/volume-osd.sh mute"
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "pgrep -x wlogout >/dev/null || wlogout -b 1 -c 20 -r 20 -L 1700 -R 1700 -T 325 -B 325"
    }
}
